# Copy to .env (never commit .env). Values here are placeholders.

# --- app (Vite, build time) ---
# Cooperative server the app syncs to.
VITE_API_URL=http://localhost:8000

# --- server ---
# Allowed app origins for CORS, comma-separated.
APP_ORIGIN=http://localhost:5173,http://localhost:4173
# SQLite file (free hosts may wipe disk; the server reseeds the SYNTHETIC registry when empty).
# JIRANI_DB=server/jirani.db

# SMS gateway: mock (default, nothing is sent) or live (provider trial/sandbox).
SMS_PROVIDER=mock
# Which live provider (set at M6b): twilio | africastalking
SMS_LIVE_PROVIDER=
# ONLY these numbers may ever receive a real SMS (your own team's phones), comma-separated E.164.
DEMO_SMS_ALLOWLIST=
# Map one or two SYNTHETIC neighbour plots to allowlisted demo phones: OND-0012=+2547XXXXXXXX
DEMO_PLOT_PHONES=
# Provider credentials (env only; filled in at M6b)
