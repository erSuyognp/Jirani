# Copy to .env (never commit .env). Values here are placeholders.

# --- app (Vite, build time) ---
# Cooperative server the app syncs to.
VITE_API_URL=http://localhost:8000

# --- server ---
# Allowed app origins for CORS, comma-separated.
APP_ORIGIN=http://localhost:5173,http://localhost:4173
# Links on the landing page (optional). APP_URL defaults to the first https origin in APP_ORIGIN.
# APP_URL=https://your-app.vercel.app
# REPO_URL=https://github.com/erSuyognp/Jirani
# SQLite file (free hosts may wipe disk; the server reseeds the SYNTHETIC registry when empty).
# JIRANI_DB=server/jirani.db

# SMS gateway. The hackathon build ships with the mock only: neighbour alerts are written to the outbox as
# "would be sent". Real delivery needs carrier registration with an SMS provider (weeks; out of scope).
SMS_PROVIDER=mock

# --- narration for the /simulation page (build time only) ---
# Used by scripts/build_narration.py to make the MP3 clips in server/static/narration/. The server does not need it.
# ELEVENLABS_API_KEY=

# --- future: real SMS provider (not used in this build) ---
# The live gateway, allowlist and tests stay in server/sms_gateway.py so a provider can be plugged in later.
# SMS_LIVE_PROVIDER=twilio
# DEMO_SMS_ALLOWLIST=        # ONLY these numbers could ever receive a real SMS (E.164, comma-separated)
# DEMO_PLOT_PHONES=          # optional: OND-0012=+2547XXXXXXXX
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
