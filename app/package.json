{
  "name": "jirani-app",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "copy-ort": "node scripts/copy-ort.mjs",
    "dev": "npm run copy-ort && vite",
    "build": "npm run copy-ort && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:android": "npm run copy-ort && vite build --mode android && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/share": "8.0.3",
    "idb": "8.0.3",
    "lucide-react": "1.51.0",
    "onnxruntime-web": "1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "workbox-window": "7.4.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
